[Unit]
Description=dae-ui panel for dae
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/usr/local/dae-ui
ExecStart=/usr/bin/python3 /usr/local/dae-ui/app.py
Restart=on-failure
RestartSec=3s
Environment=DAEUI_PORT=9623

[Install]
WantedBy=multi-user.target
